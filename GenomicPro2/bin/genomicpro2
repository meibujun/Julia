function run_server(args)
    println("="^80)
    println("Starting GenomicPro2 Web Server")
    println("="^80)

    if haskey(args, "config") && args["config"] !== nothing
        config = load_config(args["config"])
        setup_logging_from_config(config)
    end

    start_server(host=args["host"], port=args["port"])
end

function run_config(args)
    if args["show"]
        config = load_config(get(args, "file", "GenomicPro2.toml"))
        print_config(config)
    elseif args["create"]
        println("Creating example configuration file: $(args["file"])")
        # Copy example config
        # Implementation here
        println("✓ Configuration file created")
    else
        println("Use --show to display configuration or --create to create example")
    end
end

# ============================================================================
# Main Entry Point
# ============================================================================

function main()
    args = parse_commandline()

    # Determine which command was called
    if args["%COMMAND%"] == "gwas"
        run_gwas(args["gwas"])
    elseif args["%COMMAND%"] == "gblup"
        run_gblup(args["gblup"])
    elseif args["%COMMAND%"] == "bayesr"
        println("BayesR analysis - Implementation coming soon")
    elseif args["%COMMAND%"] == "bayescpi"
        println("BayesCπ analysis - Implementation coming soon")
    elseif args["%COMMAND%"] == "rkhs"
        println("RKHS analysis - Implementation coming soon")
    elseif args["%COMMAND%"] == "deepgblup"
        println("Deep GBLUP analysis - Implementation coming soon")
    elseif args["%COMMAND%"] == "pca"
        run_pca(args["pca"])
    elseif args["%COMMAND%"] == "admixture"
        println("ADMIXTURE analysis - Implementation coming soon")
    elseif args["%COMMAND%"] == "qc"
        run_qc(args["qc"])
    elseif args["%COMMAND%"] == "grm"
        run_grm(args["grm"])
    elseif args["%COMMAND%"] == "server"
        run_server(args["server"])
    elseif args["%COMMAND%"] == "config"
        run_config(args["config"])
    else
        println("Unknown command. Use --help for usage information.")
        exit(1)
    end
end

# Run if executed as script
if abspath(PROGRAM_FILE) == @__FILE__
    main()
end
