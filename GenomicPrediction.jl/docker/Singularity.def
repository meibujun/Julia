Bootstrap: docker
From: julia:1.11-buster

%files
    .. /opt/GenomicPrediction

%post
    cd /opt/GenomicPrediction
    julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

%environment
    export JULIA_PROJECT=/opt/GenomicPrediction

%runscript
    exec julia --project=/opt/GenomicPrediction examples/scripts/basic_workflow.jl
